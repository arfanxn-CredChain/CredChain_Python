# HTTP
FASTAPI_PORT=8081

# Logging
LOG_LEVEL=info
LOG_OUTPUT=stdout

# Models
MODEL_DIR=/models
EASYOCR_LANGS=id,en
LLM_MAX_NEW_TOKENS=512
LLM_DEVICE=cpu
LLM_TIMEOUT_SECONDS=60
LLM_MODEL_NAME=Qwen2.5-0.5B-Instruct
LLM_MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
EMBEDDING_MODEL_NAME=LaBSE

# i18n
LOCALES_DIR=./locales

# ID extraction
CUSTOM_ID_PATTERNS_FILE=./custom_id_patterns.txt
OVERRIDE_BUILTIN_ID_PATTERNS=false
MAX_FILES_PER_REQUEST=100

# CORS (consumed inside Docker network only)
CORS_ALLOW_ORIGINS=*
