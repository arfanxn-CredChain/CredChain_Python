        {
          "name": "Extract",
          "item": [
            {
              "name": "Extract Document",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const r = pm.response.json();",
                      "pm.test('Status 200', () => { pm.response.to.have.status(200); });",
                      "pm.test('Has code', () => { pm.expect(r.code).to.be.a('number'); });",
                      "if (r.code === 500100) {",
                      "    pm.test('Extract success', () => { pm.expect(r.data).to.be.an('array'); });",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const r = pm.response.json();",
                      "if (r.data) {",
                      "    const embeddings = r.data.filter(item => item !== null).map(item => item.embedding);",
                      "    if (embeddings.length > 0) {",
                      "        pm.collectionVariables.set(\"EMBEDDINGS\", JSON.stringify(embeddings));",
                      "        pm.test(`Saved ${embeddings.length} embedding(s) to EMBEDDINGS`, () => {",
                      "            pm.expect(embeddings.length).to.be.greaterThan(0);",
                      "        });",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{API_KEY}}",
                    "type": "text",
                    "description": "API key for service authentication"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "files",
                      "type": "file",
                      "src": "test-document.pdf"
                    }
                  ]
                },
                "url": {
                  "raw": "{{BASE_URL}}/extract",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "extract"
                  ]
                },
                "description": "Extract text + IDs from documents via Gemini, then compute LaBSE embeddings. Accepts multiple files (multipart). Response data array mirrors input file order; null entries for failed files with error details in the errors map."
