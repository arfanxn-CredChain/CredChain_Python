{
  "info": {
    "name": "CredChain Python AI Service",
    "_postman_id": "credchain-python-ai-v1",
    "description": "CredChain Python AI Service — OCR, embedding-based similarity verification, and regex-based ID extraction for credential documents.\n\nAll POST endpoints accept multi-file uploads (`files: list[UploadFile]`).\nResponse envelope: `{code, message, data: list[T|null], errors: {\"files.<i>\": [...]}}`\n\nBase URL variable: set `BASE_URL` to your service address.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8081",
      "type": "string",
      "description": "Base URL of the CredChain Python AI Service"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Service liveness and model readiness check.",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": ["{{BASE_URL}}"],
              "path": ["health"]
            },
            "description": "Returns service health status and whether all ML models have finished loading."
          },
          "response": [
            {
              "name": "Healthy (models loaded)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500900,\"message\":\"Service is healthy\",\"data\":{\"status\":\"ok\",\"models_loaded\":true},\"errors\":null}"
            },
            {
              "name": "Starting (models loading)",
              "status": "Internal Server Error",
              "code": 500,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500950,\"message\":\"Models not yet loaded\",\"data\":{\"status\":\"starting\",\"models_loaded\":false},\"errors\":null}"
            }
          ]
        }
      ]
    },
    {
      "name": "Extract",
      "description": "OCR + LaBSE embedding. Accepts one or more files.",
      "item": [
        {
          "name": "POST /extract — Single File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "PDF, JPG, PNG, WEBP, or TIFF file (max 10 MB)"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/extract",
              "host": ["{{BASE_URL}}"],
              "path": ["extract"]
            },
            "description": "Upload a single credential document. Returns raw OCR text and a 768-dim LaBSE embedding."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500100,\"message\":\"Document(s) extracted successfully\",\"data\":[{\"raw_text\":\"UNIVERSITAS INDONESIA\\nName: John Doe\\nStudent Number: 2019051234\",\"embeddings\":[0.123,-0.456,\"...(768 floats total)\"]}],\"errors\":null}"
            },
            {
              "name": "Unsupported MIME type",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500140,\"message\":\"0/1 files extracted\",\"data\":[null],\"errors\":{\"files.0\":[\"Validation failed\"]}}"
            }
          ]
        },
        {
          "name": "POST /extract — Multi-File (Batch)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "First file"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Second file (repeat 'files' key for each additional file)"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/extract",
              "host": ["{{BASE_URL}}"],
              "path": ["extract"]
            },
            "description": "Upload multiple credential documents in one request. `data[i]` corresponds to `files[i]`. Failed files appear as `null` in `data` with error details in `errors.files.<i>`."
          },
          "response": [
            {
              "name": "Partial success (1 of 2 succeeded)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500100,\"message\":\"1/2 files extracted\",\"data\":[{\"raw_text\":\"...\",\"embeddings\":[\"...\"]},null],\"errors\":{\"files.1\":[\"Validation failed\"]}}"
            }
          ]
        },
        {
          "name": "POST /extract — Empty File (Error)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Empty or zero-byte file"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/extract",
              "host": ["{{BASE_URL}}"],
              "path": ["extract"]
            },
            "description": "Demonstrates per-file error handling. Empty files return null in data with error in errors.files.0."
          },
          "response": [
            {
              "name": "All files failed",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500140,\"message\":\"0/1 files extracted\",\"data\":[null],\"errors\":{\"files.0\":[\"Validation failed\"]}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Verify",
      "description": "Cosine similarity + verdict + bilingual description. Uses Option B metadata blob: a single `metadata` JSON form field pairing each file with its stored embeddings.",
      "item": [
        {
          "name": "POST /verify — Single File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Uploaded credential document to verify"
                },
                {
                  "key": "metadata",
                  "value": "[{\"stored_embeddings\":[0.1,0.2,0.3]}]",
                  "type": "text",
                  "description": "JSON array. metadata[i] pairs with files[i]. Each item must have stored_embeddings (768 floats)."
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/verify",
              "host": ["{{BASE_URL}}"],
              "path": ["verify"]
            },
            "description": "Verify one uploaded document against its stored embeddings. Returns similarity score, verdict (tampered/suspicious/low_similarity/not_similar), and a bilingual description."
          },
          "response": [
            {
              "name": "tampered (same document)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500200,\"message\":\"Verification(s) completed\",\"data\":[{\"similarity_score\":1.0,\"similarity_percent\":\"100.0%\",\"verdict\":\"tampered\",\"description\":{\"id\":\"Dokumen ini terlihat hampir identik dengan dokumen yang kami miliki (kemiripan 100.0%), yang biasanya berarti dokumen ini telah diduplikasi atau dimanipulasi.\",\"en\":\"This document looks almost identical to the one we have on file (100.0% similarity), which usually means it has been duplicated or tampered with.\"}}],\"errors\":null}"
            }
          ]
        },
        {
          "name": "POST /verify — Multi-File (Batch)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "First credential document"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Second credential document"
                },
                {
                  "key": "metadata",
                  "value": "[{\"stored_embeddings\":[0.1,0.2]},{\"stored_embeddings\":[0.3,0.4]}]",
                  "type": "text",
                  "description": "JSON array with one entry per file. len(metadata) must equal len(files)."
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/verify",
              "host": ["{{BASE_URL}}"],
              "path": ["verify"]
            },
            "description": "Verify multiple documents in one request. metadata[i] is paired with files[i] by index."
          },
          "response": []
        },
        {
          "name": "POST /verify — Metadata Length Mismatch (Error)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "One file"
                },
                {
                  "key": "metadata",
                  "value": "[{\"stored_embeddings\":[0.1]},{\"stored_embeddings\":[0.2]}]",
                  "type": "text",
                  "description": "Two metadata entries for one file — intentional mismatch"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/verify",
              "host": ["{{BASE_URL}}"],
              "path": ["verify"]
            },
            "description": "Demonstrates validation: len(files) must equal len(metadata). Returns HTTP 400 with code 500241."
          },
          "response": [
            {
              "name": "Length mismatch",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500241,\"message\":\"Invalid stored_embeddings\",\"errors\":{\"metadata\":[\"Length mismatch: 2 metadata entries vs 1 files\"]}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Extract IDs",
      "description": "Regex-based ID extraction (no LLM). Built-in patterns cover Indonesian IDs (NIK, NIP, NIM, NPWP) and generic codes (hyphenated, grouped alnum, UUID, ULID). Custom patterns configurable via CUSTOM_ID_PATTERNS_FILE env var.",
      "item": [
        {
          "name": "POST /extract-ids — Single File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Credential document to extract IDs from"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/extract-ids",
              "host": ["{{BASE_URL}}"],
              "path": ["extract-ids"]
            },
            "description": "Extract all ID-like values from a credential document using regex patterns. Returns empty list if no IDs found (not an error). Used in tier-2 verification flow when Credential ID is unknown."
          },
          "response": [
            {
              "name": "IDs found",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500300,\"message\":\"Potential IDs extracted\",\"data\":[{\"raw_text\":\"...credential text...\",\"potential_ids\":[\"2019051234\",\"UI-CS-2023-001234\",\"REG-IJZ-2023-051234\",\"7G9K-2X8M-AB12\"]}],\"errors\":null}"
            },
            {
              "name": "No IDs found (empty list)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500300,\"message\":\"Potential IDs extracted\",\"data\":[{\"raw_text\":\"plain text with no ids\",\"potential_ids\":[]}],\"errors\":null}"
            }
          ]
        },
        {
          "name": "POST /extract-ids — Multi-File (Batch)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "First document"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Second document"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/extract-ids",
              "host": ["{{BASE_URL}}"],
              "path": ["extract-ids"]
            },
            "description": "Extract IDs from multiple documents in one request. data[i] corresponds to files[i]. This endpoint does NOT call the LLM — regex only, so it completes in milliseconds per file."
          },
          "response": [
            {
              "name": "Two files processed",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"code\":500300,\"message\":\"Potential IDs extracted\",\"data\":[{\"raw_text\":\"...\",\"potential_ids\":[\"2019051234\",\"UI-CS-2023-001234\"]},{\"raw_text\":\"...\",\"potential_ids\":[\"3171012345678901\"]}],\"errors\":null}"
            }
          ]
        }
      ]
    }
  ]
}