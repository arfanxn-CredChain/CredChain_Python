        {
          "name": "Verify",
          "item": [
            {
              "name": "Verify Document (English)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const r = pm.response.json();",
                      "pm.test('Status 200', () => { pm.response.to.have.status(200); });",
                      "pm.test('Has code', () => { pm.expect(r.code).to.be.a('number'); });",
                      "if (r.code === 500200) {",
                      "    pm.test('Verify success', () => {",
                      "        pm.expect(r.data).to.be.an('array');",
                      "        pm.expect(r.data[0].similarity_score).to.be.a('number');",
                      "        pm.expect(r.data[0].verdict).to.be.a('string');",
                      "        pm.expect(r.data[0].description).to.be.a('string');",
                      "    });",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const embs = pm.collectionVariables.get(\"EMBEDDINGS\");",
                      "if (embs) {",
                      "    pm.request.body.formdata.add({",
                      "        key: \"embeddings\",",
                      "        value: embs",
                      "    });",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
